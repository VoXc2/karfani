{
  "name": "karfani",
  "version": "0.1.0",
  "private": true,
  "description": "كرفاني - Saudi Caravan Mobility & Outdoor Experience Platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "db:migrate": "pnpm --filter @karfani/database migrate:dev",
    "db:seed": "pnpm --filter @karfani/database seed",
    "db:studio": "pnpm --filter @karfani/database studio"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "prettier": "^3.8.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "@swc/core",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
