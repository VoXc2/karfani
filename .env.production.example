# Database
DATABASE_URL="postgresql://user:password@host:5432/karfani?schema=public"
REDIS_URL="redis://host:6379"

# Auth
JWT_SECRET="generate-a-secure-random-string"
JWT_REFRESH_SECRET="generate-another-secure-random-string"
OTP_EXPIRY_MINUTES=5

# Moyasar Payments (https://moyasar.com)
MOYASAR_API_KEY=""
MOYASAR_PUBLISHABLE_KEY=""

# Unifonic SMS/WhatsApp (https://unifonic.com)
UNIFONIC_APP_SID=""
UNIFONIC_SENDER_ID="KARFANI"

# AWS S3 / File Storage
AWS_REGION="me-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_PUBLIC="karfani-public"
S3_BUCKET_PRIVATE="karfani-private"

# Google Maps (optional, for geocoding)
GOOGLE_MAPS_API_KEY=""

# App
NODE_ENV="production"
API_PORT=4000
WEB_URL="https://karfani.com"
ADMIN_URL="https://admin.karfani.com"

# Frontend (public)
NEXT_PUBLIC_API_URL="https://api.karfani.com/api/v1"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-token"
